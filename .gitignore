# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory
run

# The game writes its logs beside its working directory, so launching one from this folder leaves them here
logs

# Downloaded OptiFine test jar (do not redistribute)
test-downloads/

# The harness writes everything it produces under test\: the version profile it builds, the extracted
# natives, the game directory (with the OptiFine jar the user supplied) and the run logs. None of that is
# source - and the OptiFine jars in particular must never be committed.
test/run/
test/natives/
test/*.log

# Local reference snapshot of the upstream sources
reference/

# Local build/packaging output
dist/
build-log.txt
*.log

# release/publish.ps1 闂佹眹鍨婚崰鎰板垂濮樿埖鍎嶉柛鏇ㄥ墮缁茬懓霉濠у灝鈧稑霉閸ヮ剚鍤?闂佸憡鐟禍婵單ｉ幖浣瑰仼婵炲棙鍔戦埀顒€鍊块幃?
release/tmp/

# Compiled helper tools (tools/*.java are the source)
tools/*.class

# Generated by tools/matrix.ps1 - a run artifact, not source
tools/sweep.log
tools/one-*.log

# A Lithium config file that a run dropped in the repository root
config/

# The matrix report IS committed: tools/matrix.ps1 regenerates it, and it is the record of
# which releases were actually launched with both mods.
!tools/matrix-report.md
