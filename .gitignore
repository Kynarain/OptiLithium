# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory
run

# The game writes its logs beside its working directory, so launching one from this folder leaves them here
logs

# Downloaded OptiFine test jar (do not redistribute)
test-downloads/

# The harness writes everything it produces under test\: the version profile it builds, the extracted
# natives, the game directory (with the OptiFine jar the user supplied) and the run logs. None of that is
# source - and the OptiFine jars in particular must never be committed.
test/run/
test/natives/
test/*.log

# Local reference snapshot of the upstream sources
reference/

# Local build/packaging output
dist/
build-log.txt
*.log

# release/publish.ps1 鐢熸垚鐨勬彁浜よ浇鑽?鍙槸鐣欐。鐢?
release/tmp/

# Compiled helper tools (tools/*.java are the source)
tools/*.class
